# Server
PORT=3000
NODE_ENV=production

# MongoDB Atlas (https://www.mongodb.com/atlas/database)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/exam_platform?retryWrites=true&w=majority

# JWT Secret (generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-super-secret-random-string-here-min-64-chars

# Gmail (use App Password, not regular password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_TO=recipient_email@gmail.com

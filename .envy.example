# ============================================
# Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# Server
PORT=3000
NODE_ENV=production

# MongoDB Atlas (Free Tier: https://www.mongodb.com/atlas/database)
# Create cluster -> Database Access -> Network Access -> Get connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/exam_platform?retryWrites=true&w=majority

# JWT Secret (generate strong random string)
JWT_SECRET=your-super-secret-random-string-here-min-32-chars

# Optional: Firebase config (if still using Firebase for some features)
# FIREBASE_API_KEY=xxx
# FIREBASE_PROJECT_ID=xxx
